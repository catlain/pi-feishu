{
	"name": "pi-feishu",
	"version": "0.1.0",
	"description": "Feishu (Lark) bridge extension for pi-coding-agent — outbound broadcast + inbound remote control",
	"main": "index.ts",
	"bin": {
		"pi-feishu-gateway": "bin/pi-feishu-gateway.js"
	},
	"dependencies": {
		"jiti": "^2.6.3",
		"@larksuiteoapi/node-sdk": "^1.51.0",
		"@pi-atelier/shared-utils": "^1.0.0"
	},
	"devDependencies": {
		"@vitest/coverage-v8": "^3.2.4",
		"vitest": "^3.0.0",
		"typescript": "^6.0.3"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=1.0.0",
		"@earendil-works/pi-tui": ">=1.0.0"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-coding-agent": {
			"optional": true
		},
		"@earendil-works/pi-tui": {
			"optional": true
		}
	},
	"pi": {
		"extensions": [
			"."
		]
	},
	"scripts": {
		"test": "npx vitest run",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "npm run typecheck"
	},
	"files": [
		"index.ts",
		"lib/",
		"bin/",
		"README.md",
		"README.en.md",
		"tsconfig.json",
		"package.json"
	],
	"keywords": [
		"pi-package"
	],
	"homepage": "https://catlain.github.io/pi-atelier/",
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com:catlain/pi-feishu.git"
	},
	"bugs": {
		"url": "https://github.com/catlain/pi-feishu/issues"
	},
	"license": "MIT"
}
